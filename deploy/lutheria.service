# Service systemd Lutheria (serveur EC2).
#
# Installation :
#   sudo cp deploy/lutheria.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lutheria
#
# Secrets : copier .env.example vers /etc/lutheria.env (chmod 600) et renseigner
# LUTHERIA_MIC_TOKEN — jamais dans le dépôt git.

[Unit]
Description=Lutheria — traduction vocale malgache->français
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/lutheria

# Configuration/secrets (droits 600 requis)
EnvironmentFile=/etc/lutheria.env

ExecStart=/home/ubuntu/lutheria/.venv/bin/uvicorn server.main:create_app \
    --factory \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=5

# Durcissement minimal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
