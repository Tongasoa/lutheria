# Token requis pour le client micro (producteur audio). Générer une valeur forte :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LUTHERIA_MIC_TOKEN=change-me

# Modèle ASR (repo Hugging Face ou chemin local du modèle converti CTranslate2)
LUTHERIA_ASR_MODEL=Tongasoa/whisper-malagasy-medium-full-v2
LUTHERIA_ASR_LANGUAGE=mg
# "cpu" en dev local, "cuda" sur EC2 GPU (compute_type float16 recommandé sur GPU)
LUTHERIA_ASR_DEVICE=cpu
LUTHERIA_ASR_COMPUTE_TYPE=int8

# Modèle de traduction NLLB
LUTHERIA_MT_MODEL=facebook/nllb-200-distilled-600M
LUTHERIA_MT_SRC_LANG=mlg_Latn
LUTHERIA_MT_TGT_LANG=fra_Latn
LUTHERIA_MT_DEVICE=cpu  # "cuda" sur EC2 GPU

# Endpointing VAD : silence (ms) marquant la fin d'un segment de parole
LUTHERIA_VAD_SILENCE_MS=400

# Limites de sécurité
LUTHERIA_MAX_WS_FRAME_BYTES=65536
LUTHERIA_MAX_SEGMENT_SECONDS=15
